{
  "name": "@tavelle/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply tavelle --local",
    "db:migrate:remote": "wrangler d1 migrations apply tavelle-staging --remote --env staging",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"lint: deferred until eslint boundaries land\"",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@tavelle/contracts": "workspace:*",
    "@tavelle/db": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4",
    "wrangler": "^4.51.0"
  }
}
