# Copy values into apps/api/.dev.vars for local Wrangler (never commit .dev.vars).
# Do not put production secrets here.

# Better Auth
# BETTER_AUTH_SECRET=generate-a-long-random-string-min-32-chars
# BETTER_AUTH_URL=http://127.0.0.1:5173

# Invite-only org provisioning (comma-separated)
# PLATFORM_ADMIN_EMAILS=you@example.com

# Optional transactional email (stub locally; pick Resend/Postmark later)
# EMAIL_FROM=noreply@example.com
# EMAIL_API_KEY=

# Cloudflare account (for remote deploy via Wrangler CLI — use `wrangler login`
# or set CLOUDFLARE_API_TOKEN in your shell / CI secrets; never commit tokens)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
